APP_SECRET=replace-with-a-random-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=sqlite:////var/lib/service-monitor/service_monitor.db
HOST=0.0.0.0
PORT=8000
SCHEDULER_ENABLED=true
AGENT_GRPC_ENABLED=false
AGENT_GRPC_BIND=[::]:50051
AGENT_GRPC_CERT_FILE=/etc/service-monitor/tls/server.crt
AGENT_GRPC_KEY_FILE=/etc/service-monitor/tls/server.key
